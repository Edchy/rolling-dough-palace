---
import BaseLayout from "../layouts/BaseLayout.astro";

const pizzas = [
  {
    name: "Margherita",
    img: "marg",
    text: "Tomatsås på vårt eget recept, fattigmanspesto på olivolja, färsk basilika och vitlök, toppad med mozzarella fior di latte. En klassiker.",
  },
  {
    name: "Diavola",
    img: "diavola",
    text: "Tomatsås, salami ventricina och färsk chili. Efter gräddningen toppas pizzan med vår hemliga chiliolja.",
  },
  {
    name: "Quattro formaggi",
    img: "ost",
    text: "Tomatsås och mycket ost: mozzarella fior di latte, parmesan, cheddar och gorgonzola.",
  },
];

const cities = [
  { label: "Stockholm", tone: "mint" },
  { label: "Uppsala", tone: "lilac" },
  { label: "Göteborg", tone: "yellow" },
];

const socials = [
  {
    label: "Instagram",
    href: "https://www.instagram.com/pedallingpizzapalace",
    icon: '<rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor" stroke="none" />',
  },
  {
    label: "Facebook",
    href: "https://www.facebook.com/pedalling.pizza.palace",
    icon: '<path d="M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.6C16.6 2.5 15.6 2.4 14.5 2.4c-2.4 0-4 1.5-4 4.1v2H8v3h2.5V21h3.5v-9.5h2.6l.4-3H14z" fill="currentColor" stroke="none" />',
  },
  {
    label: "TikTok",
    href: "https://www.tiktok.com/@pedallingpizzapalace",
    icon: '<path d="M15.5 2.5c.3 2.1 1.6 3.8 3.7 4.1v2.6c-1.4.1-2.7-.3-3.8-1v6.3c0 3.4-2.7 5.9-6 5.5-2.6-.3-4.6-2.5-4.6-5.1 0-3.1 2.8-5.5 5.9-5v2.8c-.4-.1-.8-.2-1.2-.2-1.4 0-2.5 1.2-2.4 2.6.1 1.3 1.2 2.3 2.5 2.3 1.4 0 2.5-1.1 2.5-2.5V2.5h2.8z" fill="currentColor" stroke="none" />',
  },
];
---

<BaseLayout
  title="Pedalling Pizza Palace – Mobil vedugnspizza"
  description="En mobil vedugnspizzeria sedan 2021. Vi kommer till er, eldar igång och serverar nygräddad pizza på bröllop, festivaler, företagsevent och fester i Stockholm och Uppsala."
>
  {/* ---------- Hero: type-led statement + framed brand photo ---------- */}
  <section class="hero">
    <div class="hero-cell hero-cell--head">
      <p class="hero-meta">Stockholm, Uppsala &amp; Göteborg</p>
      <h1>
        <span class="hero-line">Pizza på hjul,</span>
        <br class="hero-break" /><em class="hero-line"> rakt ur elden.</em>
      </h1>
      <p class="hero-lead">
        Vedugnseldad pizza, bakad på plats. Vi rullar in med pizzatrucken, eldar
        igång och gräddar. Bröllop, festivaler, företagsevent, fester och allt
        däremellan.
      </p>
    </div>

    <div class="hero-cell hero-cell--actions">
      <a class="button primary" href="/kontakt">Boka oss</a>
      <a class="button ghost" href="/event">Se vårt erbjudande</a>
    </div>

    <div class="hero-cell hero-cell--media">
      <div class="hero-collage">
        <figure class="hero-frame hero-frame--top">
          <picture>
            <source type="image/avif" srcset="/images/guys.avif" />
            <source type="image/webp" srcset="/images/guys.webp" />
            <img
              src="/images/guys.webp"
              width="900"
              height="503"
              alt="Två grundare vid den egenbyggda vedugnen på flaket av en blå pickup, med rök som stiger"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </figure>

        <figure class="hero-frame hero-frame--tilt">
          <picture>
            <source
              type="image/avif"
              srcset="/images/pizza-760.avif 760w, /images/pizza-1100.avif 1100w"
              sizes="(max-width: 900px) 80vw, 40vw"
            />
            <source
              type="image/webp"
              srcset="/images/pizza-760.webp 760w, /images/pizza-1100.webp 1100w"
              sizes="(max-width: 900px) 80vw, 40vw"
            />
            <img
              src="/images/pizza-1100.jpg"
              width="1537"
              height="1023"
              alt="Nygräddad margheritapizza som dras ut ur den flammande vedugnen"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>
      </div>
    </div>
  </section>

  {
    /* ---------- Konceptet: the pitch, told once, with the fire photo ---------- */
  }
  <section class="concept">
    <div class="concept-media">
      <picture>
        <source
          type="image/avif"
          srcset="/images/fire-760.avif 760w, /images/fire-1100.avif 1100w, /images/fire-1440.avif 1440w"
          sizes="(max-width: 900px) 100vw, 45vw"
        />
        <img
          src="/images/fire-1440.jpg"
          width="1440"
          height="1000"
          alt="Person som matar elden i den glödande vedugnen med en lång eldgaffel"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
    <div class="concept-body">
      <h2>Vårt erbjudande</h2>
      <p>
        Vi kan hyras in till allt från firmafester och kundevents till bröllop
        och trädgårdsfester. Utöver catering håller vi också workshops, där vi
        lär ut hemligheterna så att ni själva kan baka den perfekta pizzan i vår
        ugn.
      </p>
      <p class="show-note">
        Hör av er och berätta vad ni är ute efter, så pratar vi vidare.
      </p>
      <a class="button primary" href="/kontakt">Kontakt</a>
    </div>
  </section>

  {
    /* ---------- Vårt erbjudande: catering + workshops, trucks photo + CTA ---------- */
  }
  <section class="show">
    <div class="show-photo">
      <picture>
        <source type="image/avif" srcset="/images/trucks.avif" />
        <source type="image/webp" srcset="/images/trucks.webp" />
        <img
          src="/images/trucks-1600.jpg"
          alt="Två ombyggda pickuper med vedugnar på flaket, parkerade på en gräsmatta"
          width="1200"
          height="541"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
    <div class="show-body">
      <h2>En unik upplevelse</h2>
      <p>
        Pedalling Pizza Palace är en mobil vedugnspizzeria som sedan 2021 dykt
        upp på allt från bröllop och musikfestivaler till företagsevent och
        hemmafester. Konceptet är enkelt. Vi kommer hem till er, eldar igång och
        serverar sedan rykande färsk pizza direkt ur ugnen.
      </p>
      <p>
        Vi prioriterar kvalitet framför kvantitet. Schyssta råvaror, egen deg
        och ugnar vi byggt själva.
      </p>
    </div>
  </section>

  {/* ---------- Pizzorna: the standard menu ---------- */}
  <section class="menu">
    <h2 class="menu-title">Vårt standardutbud</h2>
    <p class="menu-note">
      Tre fasta favoriter. Andra önskemål? Hör av er, så fixar vi det.
    </p>
    <ul class="menu-list">
      {
        pizzas.map((pizza, i) => (
          <li class="menu-item">
            <span class="menu-index">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="menu-name">{pizza.name}</h3>
            <div class="menu-sign">
              <picture>
                <source
                  type="image/webp"
                  srcset={`/images/skylt-${pizza.img}.webp`}
                />
                <img
                  src={`/images/skylt-${pizza.img}.png`}
                  alt={`Handmålad skylt för ${pizza.name}`}
                  width="480"
                  height="620"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <p class="menu-desc">{pizza.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ---------- Cities: availability strip ---------- */}
  <section class="cities">
    <h2>Vi rullar i</h2>
    <ul class="cities-list">
      {
        cities.map((city) => (
          <li>
            <span class={`city-tag city-tag--${city.tone}`}>{city.label}</span>
          </li>
        ))
      }
    </ul>
    <p>
      Och runt omkring. Vi är mobila, så närliggande orter och udda platser är
      oftast inga problem.
    </p>
  </section>

  {
    /* ---------- About teaser: text + oven photo, links to /om-oss ---------- */
  }
  <section class="about">
    <div class="about-body">
      <h2>Cyklar, eld och egenbyggda ugnar.</h2>
      <p>
        Det började 2021 med en idé och en hopsvetsad vedugn på ett cykelflak.
        Läs vår origin-story.
      </p>
      <a class="button ghost" href="/om-oss">Om oss</a>
    </div>
    <img
      class="about-media"
      src="/images/ppp-logo.avif"
      width="424"
      height="424"
      alt="Pedalling Pizza Palace"
    />
  </section>

  {/* ---------- Socials ---------- */}
  <section class="socials">
    <h2>Följ med på resan</h2>
    <ul class="socials-list">
      {
        socials.map((social) => (
          <li>
            <a
              class={`social--${social.label.toLowerCase()}`}
              href={social.href}
              target="_blank"
              rel="noopener"
              aria-label={social.label}
            >
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={social.icon}
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ---------- Closing CTA ---------- */}
  <section class="closing">
    <h2>Sugna? Berätta vad ni planerar.</h2>
    <p>
      Hör av er med datum, plats och ungefär hur många ni är, så löser vi
      resten.
    </p>
    <div class="closing-actions">
      <a class="button primary" href="/kontakt">Boka oss</a>
    </div>
  </section>
</BaseLayout>
