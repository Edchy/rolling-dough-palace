---
import BaseLayout from "../layouts/BaseLayout.astro";

// Real press mentions from the original site's article links.
const press = [
  {
    outlet: "Uppsala Nya Tidning",
    title: "De driver en pizzeria på cykel med en vedugn på släp",
    href: "https://unt.se/nyheter/ekonomi/artikel/de-driver-en-pizzeria-pa-cykel-med-en-vedugn-pa-slap/rkmyk5zj",
  },
  {
    outlet: "P4 Uppland",
    title: "Sålde 1000 pizzor på sin cykelburna pizzaugn",
    href: "https://sverigesradio.se/artikel/salde-1000-pizzor-pa-sin-cykelburna-pizzaugn-ar-otroligt-nojda",
  },
  {
    outlet: "P4 Uppland",
    title: "Valborgsplanerna ska sälja pizza med hemmagjord cykelugn",
    href: "https://sverigesradio.se/artikel/valborgsplanerna-ska-salja-pizza-med-hemmagjord-cykelugn",
  },
  {
    outlet: "Uppsala Nya Tidning",
    title: "Möt Uppsalas cyklande pizzakollektiv",
    href: "https://unt.se/nyheter/uppsala/artikel/tv-mot-uppsalas-cyklande-pizzakollektiv/jogomvgr",
  },
  {
    outlet: "Svensk Damtidning",
    title: "Kockarna om Victorias privata middagsbesök. Därför kunde hon inte äta",
    href: "https://www.svenskdam.se/kungligt/kockarna-om-victorias-privata-middagsbesok-darfor-kunde-hon-inte-ata/8683933",
  },
  {
    outlet: "Svensk Damtidning",
    title: "Victorias dolda sjukdom. Maten hon inte kan äta",
    href: "https://www.svenskdam.se/kungligt/victorias-dolda-sjukdom-maten-hon-inte-kan-ata-har-lart-oss/8687550",
  },
];
---

<BaseLayout
  title="Om oss | Pedalling Pizza Palace"
  description="Historien bakom Pedalling Pizza Palace: mobil pizzacatering med vedugn och egenbyggda ugnar på hjul, igång sedan 2021."
>
  <section class="event-hero event-hero--lilac">
    <h1>Mobil vedugnspizzeria sedan 2021.</h1>
    <div class="event-hero__lead">
      <p>
        Pedalling Pizza Palace har sedan 2021 dykt upp på alltifrån bröllop och
        musikfestivaler till företagsevent och hemmafester.
      </p>
      <p>
        Allt gör vi själva för hand. Vi bygger våra egna ugnar, gör vår egen
        deg och bakar napolitanska pizzor med kvalitet framför kvantitet.
      </p>
    </div>
  </section>

  <section class="om-photo">
    <picture>
      <source type="image/avif" srcset="/images/hero-1920.avif" />
      <img
        src="/images/hero-1600.jpg"
        alt="Pedalling Pizza Palace på plats med fordon och vedugn"
        width="1600"
        height="523"
        loading="lazy"
        decoding="async"
      />
    </picture>
  </section>

  <section class="colour-pair">
    <div class="colour-pair__cell colour-pair__cell--mint">
      <h2>
        <span
          class="glyph-mark glyph-mark--head glyph-mark--lead glyph-mark--pedals"
          aria-hidden="true"></span>Fordonen
      </h2>
      <p>
        Vår trupp av fordon är alla sig olika. De flesta av dem från Italien. Vi
        har nämligen åkt ner med lastbil från Sverige och köpt diverse Piaggios,
        lastat på dem och fraktat hem dem.
      </p>
    </div>
    <div class="colour-pair__cell colour-pair__cell--pink">
      <h2>
        <span
          class="glyph-mark glyph-mark--head glyph-mark--lead glyph-mark--flipper"
          aria-hidden="true"></span>Ugnarna
      </h2>
      <p>
        Pizzaugnarna på samtliga fordon är handbyggda av oss. En konst vi blivit
        bättre på för var ugn vi bygger.
      </p>
    </div>
  </section>

  <section class="om-collage">
    <div class="om-collage__inner">
      <figure class="om-frame om-frame--a">
        <picture>
          <source type="image/avif" srcset="/images/trucks.avif" />
          <img
            src="/images/trucks-1600.jpg"
            alt="Ombyggda italienska Piaggio-fordon med vedugnar"
            width="1200"
            height="541"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </figure>
      <figure class="om-frame om-frame--b">
        <img
          src="/images/oven-1100.jpg"
          alt="En handbyggd vedugn på ett av fordonen"
          width="1100"
          height="731"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="page-band page-band--lilac om-work">
    <div class="page-band__head page-band__head--stack">
      <h2>
        <span
          class="glyph-mark glyph-mark--head glyph-mark--lead glyph-mark--pizza-flipper"
          aria-hidden="true"></span>Så jobbar vi
      </h2>
      <p>
        Vi prioriterar kvalitet framför kvantitet. Schyssta råvaror, egen deg
        och egna ugnar.
      </p>
      <p>
        Allt gör vi själva för hand, från att bygga självaste pizzaugnen till
        vår egna unika pizzadeg.
      </p>
    </div>
    <picture class="om-band-media">
      <source type="image/avif" srcset="/images/fire-1440.avif" />
      <img
        src="/images/fire-1440.jpg"
        alt="Elden i en av de vedeldade ugnarna"
        width="1440"
        height="960"
        loading="lazy"
        decoding="async"
      />
    </picture>
  </section>

  {/* ---------- Press: real mentions, outbound cards ---------- */}
  <section class="press">
    <h2>Snacket går</h2>
    <ul class="press-list">
      {
        press.map((item) => (
          <li class="press-card">
            <a href={item.href} target="_blank" rel="noopener noreferrer">
              <span class="press-outlet">{item.outlet}</span>
              <span class="press-title">{item.title}</span>
              <span class="press-go" aria-hidden="true">Läs artikeln</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="om-photo">
    <picture>
      <source type="image/avif" srcset="/images/pizza-1520.avif" />
      <img
        src="/images/pizza-1100.jpg"
        alt="Färdig napolitansk pizza direkt från vedugnen"
        width="1520"
        height="1013"
        loading="lazy"
        decoding="async"
      />
    </picture>
  </section>
</BaseLayout>
