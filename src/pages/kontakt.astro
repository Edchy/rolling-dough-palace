---
import BaseLayout from "../layouts/BaseLayout.astro";

const contacts = [
  {
    city: "Stockholm",
    tone: "mint",
    phone: "076 793 04 94",
    tel: "+46767930494",
    email: "stockholm@pedallingpizzapalace.se",
  },
  {
    city: "Uppsala",
    tone: "lilac",
    phone: "076 266 88 83",
    tel: "+46762668883",
    email: "pedallingpizzapalace@gmail.com",
  },
  {
    city: "Göteborg",
    tone: "yellow",
    phone: "073 370 72 19",
    tel: "+46733707219",
    email: "goteborg@pedallingpizzapalace.se",
  },
];

const checklist = [
  "Datum och tid",
  "Plats",
  "Ungefär antal gäster",
  "Typ av event",
];

const socials = [
  {
    label: "Instagram",
    handle: "@pedallingpizzapalace",
    href: "https://www.instagram.com/pedallingpizzapalace",
    tone: "lilac",
    icon: '<rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor" stroke="none" />',
  },
  {
    label: "Facebook",
    handle: "/pedalling.pizza.palace",
    href: "https://www.facebook.com/pedalling.pizza.palace",
    tone: "paper",
    icon: '<path d="M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.6C16.6 2.5 15.6 2.4 14.5 2.4c-2.4 0-4 1.5-4 4.1v2H8v3h2.5V21h3.5v-9.5h2.6l.4-3H14z" fill="currentColor" stroke="none" />',
  },
  {
    label: "TikTok",
    handle: "@pedallingpizzapalace",
    href: "https://www.tiktok.com/@pedallingpizzapalace",
    tone: "accent",
    icon: '<path d="M15.5 2.5c.3 2.1 1.6 3.8 3.7 4.1v2.6c-1.4.1-2.7-.3-3.8-1v6.3c0 3.4-2.7 5.9-6 5.5-2.6-.3-4.6-2.5-4.6-5.1 0-3.1 2.8-5.5 5.9-5v2.8c-.4-.1-.8-.2-1.2-.2-1.4 0-2.5 1.2-2.4 2.6.1 1.3 1.2 2.3 2.5 2.3 1.4 0 2.5-1.1 2.5-2.5V2.5h2.8z" fill="currentColor" stroke="none" />',
  },
];
---

<BaseLayout
  title="Kontakt | Pedalling Pizza Palace"
  description="Kontakta Pedalling Pizza Palace för bokning i Stockholm, Uppsala och Göteborg. Mobil vedugnspizza för bröllop, företag, fester och event."
>
  <section class="event-hero event-hero--yellow">
    <h1>Ring, maila, boka elden.</h1>
    <div class="event-hero__lead">
      <p>
        Har ni frågor först? Maila eller ring den stad som passar bäst, så
        snackar vi upplägg.
      </p>
    </div>
  </section>

  <section class="contact-cards" id="kontaktkort">
    <h2>
      <span
        class="glyph-mark glyph-mark--head glyph-mark--lead glyph-mark--onion"
        aria-hidden="true"></span>Direkt till rätt stad.
    </h2>
    <ul class="contact-card-list">
      {
        contacts.map((contact) => (
          <li class={`contact-card contact-card--${contact.tone}`}>
            <h3>{contact.city}</h3>
            <div class="contact-card__links">
              <a href={`tel:${contact.tel}`}>
                <span>Telefon</span>
                <strong>{contact.phone}</strong>
              </a>
              <a href={`mailto:${contact.email}`}>
                <span>Mail</span>
                <strong>{contact.email}</strong>
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="contact-brief">
    <div>
      <h2>Skicka det ni vet.</h2>
      <p>
        Det behöver inte vara färdigplanerat. Ge oss startpunkten, så tar vi
        resten i dialog.
      </p>
      <a class="button primary contact-brief__cta" href="mailto:stockholm@pedallingpizzapalace.se">
        Boka oss
      </a>
    </div>
    <ul>
      {
        checklist.map((item) => (
          <li>
            <span class="glyph-mark" aria-hidden="true" />
            {item}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="socials">
    <h2 class="socials-title">
      <span
        class="glyph-mark glyph-mark--head glyph-mark--lead glyph-mark--chilli"
        aria-hidden="true"></span>Fråga där ni hänger
    </h2>
    <ul class="socials-list">
      {
        socials.map((social) => (
          <li class={`social-row social-row--${social.tone}`}>
            <a
              class="social-link"
              href={social.href}
              target="_blank"
              rel="noopener"
              aria-label={social.label}
            >
              <span class="social-name">{social.label}</span>
              <span class="social-handle">{social.handle}</span>
              <span class="social-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="24"
                  height="24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={social.icon}
                />
              </span>
              <span class="social-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
