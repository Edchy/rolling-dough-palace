---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BookingModal from "../components/BookingModal.astro";
import "../styles/global.css";

const {
  title = "Pedalling Pizza Palace",
  description = "Mobil vedugnspizzeria. Vi kommer till er, tänder ugnen och serverar nygräddad pizza på bröllop, festivaler och event i Stockholm och Uppsala.",
} = Astro.props;

const palette = "pastel";
---

<!doctype html>
<html lang="sv" data-palette={palette}>
  <head>
    <meta charset="UTF-8" />
    {/* Apply the saved palette before paint to avoid a theme flash. */}
    <script is:inline>
      try {
        var t = localStorage.getItem("ppp-theme");
        if (t) document.documentElement.setAttribute("data-palette", t);
      } catch (e) {}
    </script>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2a2350" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,500;1,9..144,600&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <BookingModal />
  </body>
</html>
