---
/* Shared home-page content for the index page. */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pizzas = [
  {
    name: "Röd kant",
    img: "marg",
    text: "Långkokt tomat, fior di latte, basilika och lagrad svensk hårdost. Vår raka, röda startpunkt.",
  },
  {
    name: "Het honung",
    img: "diavola",
    text: "Tomat, rökt salami, picklad chili och honung med sting. Söt först, varm strax efter.",
  },
  {
    name: "Grön glöd",
    img: "ost",
    text: "Fior di latte, grillad vårlök, citron, örter och rostad vitlök. Ingen tomat, ingen ursäkt.",
  },
];

const cities = [
  { label: "Skåne", tone: "mint" },
  { label: "Halland", tone: "lilac" },
  { label: "Småland", tone: "yellow" },
];

const socials = [
  {
    label: "Instagram",
    handle: "@rollingdoughpalace",
    href: "#",
    tone: "lilac",
    icon: '<rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor" stroke="none" />',
  },
  {
    label: "Facebook",
    handle: "/rollingdoughpalace",
    href: "#",
    tone: "paper",
    icon: '<path d="M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.6C16.6 2.5 15.6 2.4 14.5 2.4c-2.4 0-4 1.5-4 4.1v2H8v3h2.5V21h3.5v-9.5h2.6l.4-3H14z" fill="currentColor" stroke="none" />',
  },
  {
    label: "TikTok",
    handle: "@rollingdoughpalace",
    href: "#",
    tone: "accent",
    icon: '<path d="M15.5 2.5c.3 2.1 1.6 3.8 3.7 4.1v2.6c-1.4.1-2.7-.3-3.8-1v6.3c0 3.4-2.7 5.9-6 5.5-2.6-.3-4.6-2.5-4.6-5.1 0-3.1 2.8-5.5 5.9-5v2.8c-.4-.1-.8-.2-1.2-.2-1.4 0-2.5 1.2-2.4 2.6.1 1.3 1.2 2.3 2.5 2.3 1.4 0 2.5-1.1 2.5-2.5V2.5h2.8z" fill="currentColor" stroke="none" />',
  },
];
---

{/* ---------- Hero: type-led statement + framed brand photo ---------- */}
<section class="hero">
  <div class="hero-cell hero-cell--head">
    <p class="hero-meta">Skåne, Halland &amp; Småland</p>
    <h1>
      <span class="hero-line">Bra kant.</span>
      <br class="hero-break" /><em class="hero-line"> Full glöd.</em>
    </h1>
    <p class="hero-lead">
      Surdegspizza bakad där ni är. Vi tar med ugn, ved och tempo till gårdar,
      festivaler, bröllop och andra kvällar som förtjänar en egen eld.
    </p>
  </div>

  <div class="hero-cell hero-cell--actions">
    <button class="button primary" type="button" data-booking-trigger>Boka oss</button>
    <a class="button ghost" href={`${base}/catering`}>Se hur det funkar</a>
  </div>

  <div class="hero-cell hero-cell--media">
    <div class="hero-collage">
      <figure class="hero-frame hero-frame--top">
        <picture>
          <img
            src={`${base}/images/kant-glod-team.png`}
            width="1672"
            height="941"
            alt="Två pizzabagare arbetar med deg och eld vid en mobil vedugn"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </figure>

      <figure class="hero-frame hero-frame--tilt">
        <picture>
          <img
            src={`${base}/images/kant-glod-pizza.png`}
            width="1536"
            height="1024"
            alt="Blåsig surdegspizza med vårlök och chili på väg ut ur vedugnen"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </figure>
    </div>
  </div>
</section>

{/* ---------- Konceptet: the pitch, told once, with the fire photo ---------- */}
<section class="concept">
  <div class="concept-media">
    <picture>
      <img
        src={`${base}/images/kant-glod-fire.png`}
        width="1448"
        height="1086"
        alt="En pizzabagare ordnar veden i en glödande vedugn"
        loading="lazy"
        decoding="async"
      />
    </picture>
  </div>
  <div class="concept-body">
    <h2>
      <span
        class="glyph-mark glyph-mark--head glyph-mark--lead glyph-mark--fire"
        aria-hidden="true"></span>Vårt erbjudande
    </h2>
    <p>
      Vi bygger en liten pizzeria mitt i ert sammanhang. Menyn är kort,
      serveringen rörlig och pizzorna kommer ut när de är som bäst. Vill ni
      själva få mjöl på händerna håller vi också praktiska degverkstäder.
    </p>
    <p class="show-note">
      Ge oss en plats, ett datum och ett ungefärligt antal hungriga.
    </p>
    <a class="button primary" href={`${base}/kontakt`}>Kontakt</a>
  </div>
</section>

{/* ---------- Vårt erbjudande: catering + workshops, trucks photo + CTA ---------- */}
<section class="show">
  <div class="show-photo">
    <picture>
      <img
        src={`${base}/images/kant-glod-trailer.png`}
        alt="Röd mobil pizzavagn med vedugn i en grön industrigård"
        width="1942"
        height="809"
        loading="lazy"
        decoding="async"
      />
    </picture>
  </div>
  <div class="show-body">
    <h2>
      <span
        class="glyph-mark glyph-mark--head glyph-mark--lead glyph-mark--flipper"
        aria-hidden="true"></span>En pizzeria som dyker upp.
    </h2>
    <p>
      Rolling Dough Palace är en fiktiv, rörlig pizzaverkstad född ur en enkel idé:
      den bästa serveringen händer mitt i festen. Vagnen öppnas, veden tänds
      och varje pizza bakas framför gästerna.
    </p>
    <p>
      Vi jobbar med långjäst deg, svenska råvaror när säsongen tillåter och en
      meny liten nog att kunna göras riktigt bra.
    </p>
  </div>
</section>

{/* ---------- Pizzorna: the standard menu ---------- */}
<section class="menu">
  <h2 class="menu-title">Tre från ugnen</h2>
  <p class="menu-note">
    En koncentrerad meny som kan byta skepnad med platsen och säsongen.
  </p>
  <ul class="menu-list">
    {
      pizzas.map((pizza) => (
        <li class="menu-item">
          <h3 class="menu-name">{pizza.name}</h3>
          <div class="menu-sign">
            <span
              class={`glyph-mark glyph-mark--${pizza.img === "marg" ? "margherita" : pizza.img}`}
              aria-hidden="true"
            />
          </div>
          <p class="menu-desc">{pizza.text}</p>
        </li>
      ))
    }
  </ul>
</section>

{/* ---------- Cities: availability strip ---------- */}
<section class="cities">
  <h2>
    Här eldar vi<span class="glyph-mark glyph-mark--head" aria-hidden="true"
    ></span>
  </h2>
  <ul class="cities-list">
    {
      cities.map((city) => (
        <li>
          <span class={`city-tag city-tag--${city.tone}`}>{city.label}</span>
        </li>
      ))
    }
  </ul>
  <p>
    Plus omvägarna. Finns det en plan yta, rimlig framkomlighet och hungriga
    människor kan vi oftast hitta dit.
  </p>
</section>

{/* ---------- About teaser: text + oven photo, links to /om-oss ---------- */}
<section class="about">
  <div class="about-body">
    <h2>Mjöl, metall och en ganska stor eld.</h2>
    <p>
      Rolling Dough Palace är en påhittad identitet skapad för det här
      portfolio-projektet. Läs berättelsen bakom konceptet.
    </p>
    <a class="button primary" href={`${base}/om-oss`}>Om oss</a>
  </div>
  <img
    class="about-media"
    src={`${base}/images/kant-glod-fire.png`}
    width="1448"
    height="1086"
    alt="Vedeldad pizzaugn i skymningen"
  />
</section>

{/* ---------- Socials ---------- */}
<section class="socials">
  <h2 class="socials-title">
    <span
      class="glyph-mark glyph-mark--head glyph-mark--lead glyph-mark--chilli"
      aria-hidden="true"></span>Håll koll på glöden.
  </h2>
  <ul class="socials-list">
    {
      socials.map((social) => (
        <li class={`social-row social-row--${social.tone}`}>
          <a
            class="social-link"
            href={social.href}
            target="_blank"
            rel="noopener"
            aria-label={social.label}
          >
            <span class="social-name">{social.label}</span>
            <span class="social-handle">{social.handle}</span>
            <span class="social-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={social.icon}
              />
            </span>
            <span class="social-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

{/* ---------- Closing CTA ---------- */}
<section class="closing">
  <h2>
    <span
      class="glyph-mark glyph-mark--head glyph-mark--lead glyph-mark--cutter"
      aria-hidden="true"></span>Har ni platsen? Vi har elden.
  </h2>
  <p>
    Skicka datum, plats och ungefär hur många som ska äta. <br /> Vi tar det därifrån.
  </p>
  <div class="closing-actions">
    <button class="button primary" type="button" data-booking-trigger>Boka oss</button>
  </div>
</section>
