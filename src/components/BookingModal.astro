          <path d="m355.22 198.44c0 29.641-44.461 29.641-44.461 0s44.461-29.641 44.461 0z" />
          <path d="m352.2 284.34c0 29.641-44.48 29.641-44.48 0s44.48-29.641 44.48 0z" />
          <path d="m350.18 362.16c0 29.641-44.48 29.641-44.48 0s44.48-29.641 44.48 0z" />
        </svg>
      </div>
    </form>
  </div>
</dialog>

<script>
  const bookingModal = document.querySelector<HTMLDialogElement>("#booking-modal");
  const bookingForm = bookingModal?.querySelector<HTMLFormElement>(".booking-form");
  const bookingClose = bookingModal?.querySelector<HTMLButtonElement>(".booking-modal__close");
  let bookingReturnTarget: HTMLElement | null = null;

  const closeNavModal = () => {
    const navModal = document.querySelector<HTMLElement>(".nav-modal");
    const navToggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    if (!navModal?.classList.contains("is-open")) return;

    navModal.classList.remove("is-open");
    navModal.hidden = true;
    document.documentElement.classList.remove("nav-locked");
    navToggle?.setAttribute("aria-expanded", "false");
  };

  const openBookingModal = (target: HTMLElement | null) => {
    if (!bookingModal) return;

    bookingReturnTarget = target;
    closeNavModal();

    if (typeof bookingModal.showModal === "function") {
      bookingModal.showModal();
    } else {
      bookingModal.setAttribute("open", "");
    }
    document.documentElement.classList.add("booking-locked");
  };

  const closeBookingModal = () => {
    if (!bookingModal) return;

    if (bookingModal.open && typeof bookingModal.close === "function") {
      bookingModal.close();
    } else {
      bookingModal.removeAttribute("open");
    }
  };

  document.querySelectorAll<HTMLElement>("[data-booking-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      openBookingModal(trigger);
    });
  });

  bookingClose?.addEventListener("click", closeBookingModal);

  bookingForm?.addEventListener("submit", (event) => {
    event.preventDefault();
  });

  bookingModal?.addEventListener("click", (event) => {
    if (event.target === bookingModal) closeBookingModal();
  });

  bookingModal?.addEventListener("close", () => {
    document.documentElement.classList.remove("booking-locked");
    bookingReturnTarget?.focus();
    bookingReturnTarget = null;
  });
</script>
